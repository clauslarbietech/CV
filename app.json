{
  "expo": {
    "name": "Pix Bible",
    "slug": "pix-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A2E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Record short voice reflections for each Bible chapter.",
        "NSSpeechRecognitionUsageDescription": "Optional speech features for audio guide accessibility.",
        "UIAccessibilityEnabled": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/CV/pixbible"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Pix Bible to record chapter voice reflections.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font"
    ]
  }
}
